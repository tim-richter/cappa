{
  "name": "@cappa/protocol",
  "version": "0.9.0",
  "description": "Wire contract shared by the Cappa server, clients and review UI",
  "type": "module",
  "license": "MIT",
  "author": "Tim Richter",
  "repository": {
    "type": "git",
    "url": "https://github.com/tim-richter/cappa.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "screenshot",
    "protocol"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsc",
    "test": "vitest",
    "test:run": "vitest --run",
    "attw": "attw --pack --profile node16 ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@cappa/core": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
