{
  "name": "@cappa/plugin-storybook",
  "version": "0.9.0",
  "description": "Storybook plugin for Cappa - takes screenshots of Storybook stories",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tim-richter/cappa.git"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Tim Richter",
  "type": "module",
  "main": "./dist/index.cjs.cjs",
  "module": "./dist/index.esm.mjs",
  "types": "./dist/index.esm.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.esm.d.mts",
        "default": "./dist/index.esm.mjs"
      },
      "require": {
        "types": "./dist/index.cjs.d.cts",
        "default": "./dist/index.cjs.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest --run",
    "build": "tsdown",
    "tsc": "tsc",
    "attw": "attw --pack --profile node16 ."
  },
  "keywords": [
    "storybook-addon",
    "test",
    "screenshot",
    "plugin",
    "storybook",
    "visual-testing",
    "visual regression",
    "vrt",
    "playwright",
    "cappa"
  ],
  "storybook": {
    "displayName": "Cappa",
    "icon": "https://raw.githubusercontent.com/tim-richter/cappa/main/packages/plugins/plugin-storybook/assets/cappa-icon.png",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact"
    ]
  },
  "peerDependencies": {
    "storybook": "^9 || ^10"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": false
    }
  },
  "dependencies": {
    "@cappa/core": "workspace:*",
    "@cappa/logger": "workspace:*",
    "@swc/core": "^1.16.2",
    "chalk": "^6.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "playwright-core": "^1.63.0",
    "storybook": "^10.6.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
